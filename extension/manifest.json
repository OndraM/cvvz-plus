{
  "manifest_version": 3,
  "name": "CVVZ plus",
  "version": "2026.10.2",
  "description": "Neoficiální rozšíření pro přehlednější web CVVZ",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options/options.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.cvvz.cz/*"],
      "js": [
        "src/shared/features.js",
        "src/site/features/logo-plus.js",
        "src/site/features/back-to-top.js",
        "src/program/parse.js",
        "src/program/layout.js",
        "src/program/program-list.js",
        "src/program/features/filter-form.js",
        "src/program/features/program-type.js",
        "src/program/features/permalink.js",
        "src/program/features/labels.js",
        "src/program/features/lecturer.js",
        "src/program/features/description.js",
        "src/program/features/terms.js",
        "src/program/features/program-card.js",
        "src/program/features/term-capacity.js",
        "src/program/features/program-count.js",
        "src/participants/table.js",
        "src/participants/features/stats.js",
        "src/participants/features/compact-table.js",
        "src/participants/features/contacts.js",
        "src/main.js"
      ],
      "css": [
        "src/shared/features.css",
        "src/site/features/logo-plus.css",
        "src/site/features/back-to-top.css",
        "src/program/layout.css",
        "src/program/features/filter-form.css",
        "src/program/features/program-type.css",
        "src/program/features/permalink.css",
        "src/program/features/labels.css",
        "src/program/features/lecturer.css",
        "src/program/features/description.css",
        "src/program/features/terms.css",
        "src/program/features/program-card.css",
        "src/program/features/term-capacity.css",
        "src/program/features/program-count.css",
        "src/participants/features/stats.css",
        "src/participants/features/compact-table.css",
        "src/participants/features/contacts.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cvvz-plus@ondram",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
